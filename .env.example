TRIGGER_PROJECT_REF=project_ref

# get PAT from https://cloud.trigger.dev/account/tokens
TRIGGER_API_KEY=tr_pat

# Mock-mode controls (optional)
# Probability that a fault injection aware task fails on its first attempt.
# 0 = never fail (default). 1.0 = always fail attempt 1. Use to probe retries.
MOCK_FAULT_RATE=0

# Real AI mode
# If set, OpenAI gpt-4o vision is used instead of MockVisionProvider.
# OPENAI_API_KEY=openai_sk

# DB (optional override, defaults to ./data/snapbasket.db)
# DATABASE_URL=./data/snapbasket.db
